# =====================================================================
#  .env.example —— 复制成 .env 再填（.env 已被 gitignore，不会泄露）
#  命令：copy Codes\.env.example Codes\.env
# =====================================================================

# ---------- 1. 大模型（大脑）----------
# ⚠️ 比赛必须用 AIA 统一代理；下面是赛前本地联调用的 DeepSeek 示例。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-换成你自己的

# ---------- 2. 赛事 Bot 账号（皮肤站）----------
MC_USERNAME=你的皮肤站用户名
MC_PASSWORD=你的皮肤站密码

# ---------- 3. 后端选择 ----------
# nmo       = 比赛服 NMO 接口（默认）
# my_server = 你自己的服务器 / 局域网测试（配 Codes/local_bot/ 用）
BACKEND=nmo

# ---------- 4. 以后接你自己的服务器（可选）----------
MY_SERVER_BASE=
MY_SERVER_TOKEN=
MY_SERVER_TIMEOUT=30

# ---------- 5. 网络延迟（可选）----------
# 控制台逐条打印每次 API/LLM 交互的延迟；嫌吵改成 false
PRINT_LATENCY=true
# 单次超过多少毫秒打告警日志
NET_LATENCY_WARN_MS=3000

# chat
CHAT_MAX_CHARS=25
CHAT_COOLDOWN_S=1.2
# pre-competition: keep false; set true on competition day
COMPETITION_MODE=false
LOOP_LIMIT=10
